{
	"author": "Lorenzo Lannino",
	"license": "MIT",
	"name": "wompo-docs",
	"description": "Documentation for Wompo",
	"version": "1.0.0",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"old-dev": "./esbuild.config.mjs",
		"dev": "esbuild `find ./src \\( -name '*.ts' -o -name '*.tsx' \\)` --outdir=dist --allow-overwrite --minify & nodemon app.js",
		"dev-build": "esbuild `find ./src \\( -name '*.ts' -o -name '*.tsx' \\)` --outdir=dist --allow-overwrite --watch",
		"build": "esbuild `find ./src \\( -name '*.ts' -o -name '*.tsx' \\)` --outdir=dist --allow-overwrite --minify",
		"start": "node app.js"
	},
	"dependencies": {
		"compression": "^1.7.4",
		"express": "^4.19.2",
		"helmet": "^7.1.0",
		"wompo": "^1.0.4",
		"wompo-router": "^1.1.3"
	},
	"devDependencies": {
		"concurrently": "^8.2.2",
		"esbuild": "^0.20.2",
		"nodemon": "^3.1.0",
		"ts-loader": "^9.5.1"
	}
}
