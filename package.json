{
	"author": "Lorenzo Lannino",
	"license": "MIT",
	"name": "wompo-docs",
	"description": "Documentation for Wompo",
	"version": "2.0.0",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"dev": "bun --preserve-symlinks ./node_modules/seawomp/dist/cli.js dev",
		"build": "bun --preserve-symlinks ./node_modules/seawomp/dist/cli.js build",
		"build:vercel": "bun --preserve-symlinks ./node_modules/seawomp/dist/cli.js build --target vercel",
		"docs:format-code": "bun scripts/format-docs-code.ts",
		"docs:check-code": "bun scripts/check-docs-code.ts",
		"serve:static": "bun --preserve-symlinks ./node_modules/seawomp/dist/cli.js start",
		"serve:vercel-like": "bun scripts/vercel-like-server.ts",
		"start": "bun --preserve-symlinks ./node_modules/seawomp/dist/cli.js start"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"gsap": "^3.15.0",
		"marked": "^15.0.12",
		"seawomp": "^1.2.5",
		"wompo": "^2.0.4"
	},
	"devDependencies": {
		"@types/bun": "^1.1.0",
		"@types/node": "^22.0.0",
		"lighthouse": "^13.3.0",
		"sharp": "^0.34.5",
		"typescript": "^5.6.0"
	}
}
